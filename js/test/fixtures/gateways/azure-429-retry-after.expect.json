{
  "provider": "Azure OpenAI (<resource>.openai.azure.com/openai/v1)",
  "source": "from docs: learn.microsoft.com/azure/ai-foundry/openai/reference (error envelope with innererror)",
  "model": "gpt-4o",
  "http": {
    "status": 429,
    "contentType": "application/json",
    "headers": {
      "retry-after": "7"
    }
  },
  "basePath": "/openai/v1",
  "expect": {
    "error": {
      "code": "RATE_LIMIT",
      "status": 429,
      "retryAfterMs": 7000
    }
  },
  "body": "azure-429-retry-after.json"
}
